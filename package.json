{
  "name": "invoice-check-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Checks invoices against what was agreed (contracts, POs, offers, devize, leases) using Claude for extraction and deterministic rules for decisions.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "seed": "tsx src/cli/seed.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "check": "tsx src/cli/check.ts",
    "check:all": "tsx src/cli/check-all.ts",
    "ledger": "tsx src/cli/ledger.ts",
    "eval": "tsx src/cli/eval.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "big.js": "^7.0.1",
    "cli-table3": "^0.6.5",
    "ora": "^10.0.0",
    "pdfkit": "^0.20.2",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.5",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
