# Anthropic API key — never commit a real key. Copy this file to .env.
ANTHROPIC_API_KEY=

# Default model for all tasks; per-task overrides below (optional).
ANTHROPIC_MODEL=claude-opus-5-5
MODEL_CLASSIFY=claude-haiku-5-5
MODEL_EXTRACT=claude-opus-5-5
MODEL_MATCH=claude-sonnet-5-5
MODEL_REPORT=claude-sonnet-5-5

# Server-side refusal fallback (beta) on Opus/Sonnet calls. Set to false to disable.
LLM_REFUSAL_FALLBACK=true

# Paths
DB_PATH=./data/invoice-check.db
LLM_CACHE_DIR=./.cache/llm
DEFAULT_PROFILE=developer
